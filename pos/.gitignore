# Dependencies — never commit or sync these. The repo currently carries a
# Linux-built node_modules and venv through OneDrive, which is why the
# production `ng build` fails on a Windows checkout with
# "You installed esbuild for another platform".
node_modules/
venv/
env/
.venv/

# Build output
dist/
.angular/
staticfiles/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Secrets — never commit
.env
*.env
!.env.example

# Local databases and logs
db.sqlite3
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log

