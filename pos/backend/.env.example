# ─────────────────────────────────────────────────────────────────────────────
# POS Backend Environment Configuration
# COPY this to .env and fill in real values before deploying.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Django Core
DJANGO_SECRET_KEY=<generate-a-new-secret-key-here>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,38.45.94.56

# ── PRODUCTION: set DEBUG=False and configure your real domain below ──────────
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,38.45.94.56

# Database (MySQL). DB_ENGINE=mysql switches from SQLite; leave it unset (or
# "sqlite") to keep the local SQLite file. Run the test suite on MySQL with
# TEST_DB_ENGINE=mysql (Django creates and drops a `test_pos` database).
DB_ENGINE=mysql
DB_NAME=pos
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# CORS & CSRF (space-separated if multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://38.45.94.56:4092
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:8000,http://38.45.94.56:4092,http://38.45.94.56:8092

# ── Cache / Redis (REQUIRED for 20K+ daily traffic) ───────────────────────────
# Install Redis on your server, then set this URL.
# Without this, caching falls back to in-process memory (not shared across workers).
# pip install redis django-redis  (already in requirements.txt)
# REDIS_URL=redis://localhost:6379/0

# ── SAP Business One / HANA ────────────────────────────────────────────────────
# These used to be written into the code. Without them nothing is sent to SAP:
# every posting waits on the retry queue until they are set.
# SAP_ENABLED=0 switches SAP off on purpose (postings queue, nothing is lost).
# SAP_SCHEDULER=0 stops this process running the retry worker.
SAP_ENABLED=1
SAP_SCHEDULER=1
SAP_SERVICE_LAYER_URL=https://your-sap-server:50000/b1s/v1
SAP_COMPANY_DB=YOUR_COMPANY_DB
SAP_USERNAME=your-sap-user
SAP_PASSWORD=change-me
SAP_VERIFY_TLS=0
HANA_ADDRESS=your-hana-host
HANA_PORT=30015
HANA_USER=your-hana-user
HANA_PASSWORD=change-me
HANA_SCHEMA=YOUR_SCHEMA
